{
  "name": "academik-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Academik — Application mobile iOS & Android",
  "scripts": {
    "build:web": "cd .. && npm run build",
    "sync": "npx cap sync",
    "copy": "npx cap copy",
    "build:android": "npm run build:web && npx cap copy android && npx cap sync android",
    "build:ios": "npm run build:web && npx cap copy ios && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "sharp": "^0.33.0"
  }
}
